# ---- Phase 1 defaults (copy to .env to override) ----

# Kafka (KRaft, no Zookeeper)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Redis (ephemeral scratchpad)
REDIS_URL=redis://localhost:6379/0

# LLM (Ollama exposes an OpenAI-compatible endpoint)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=llama3

# Orchestrator safety guard: max LLM rounds before giving up
MAX_STEPS=10
